[Unit]
Description=Nuke AI Collaborator Supervisor Service
After=network.target

[Service]
Type=simple
User=nuke
Group=nuke
WorkingDirectory=/opt/nuke-ai-collaborator/backend

# Environment configuration
Environment=NUKE_DB_PATH=/var/lib/nuke-ai-collaborator/chat.db
Environment=NUKE_WORKSPACE_ROOT=/var/lib/nuke-ai-collaborator/workspaces
Environment=NUKE_WORKERS=8
Environment=NUKE_ENV=production
Environment=NUKE_SHELL_EXEC_BACKEND=container
Environment=NUKE_SANDBOX_IMAGE=nuke-sandbox:latest
# A dedicated rootless Docker service must be started for user nuke. Do not
# replace this with the host root daemon socket. Set its user-specific path as
# DOCKER_HOST=unix:///run/user/<nuke-uid>/docker.sock in EnvironmentFile.
Environment=NUKE_DOCKER_ISOLATION=rootless
Environment=PORT=8000
Environment=HOST=0.0.0.0

# REQUIRED: security credentials (load from protected file)
# Create /etc/nuke-ai-collaborator/env with:
#   AUTH_SECRET=<strong random key ≥32 chars>
# chmod 600 /etc/nuke-ai-collaborator/env
EnvironmentFile=/etc/nuke-ai-collaborator/env

# Execution
ExecStart=/opt/nuke-ai-collaborator/backend/venv/bin/python -m uvicorn main:app --host ${HOST} --port ${PORT}
Restart=always
RestartSec=5s

# Operational Hardening & Resource Limits
MemoryMax=4G
MemoryLimit=4G
CPUQuota=200%
LimitNOFILE=65536

# System sandboxing options
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/nuke-ai-collaborator /opt/nuke-ai-collaborator/backend/logs /opt/nuke-ai-collaborator/backend/uploads

[Install]
WantedBy=multi-user.target
